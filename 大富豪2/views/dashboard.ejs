<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - ダッシュボード</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>ようこそ、<%= username %> さん</h1>
    <p style="text-align:center; font-size:18px;">現在の所持ポイント: <strong><%= score %> pt</strong></p>
    
    <div style="margin-top: 30px;">
      <h2>ゲームを開始する</h2>
      <form action="/game" method="GET">
        <div class="form-group">
          <label>ゲームIDを入力</label>
          <input type="text" name="game_id" placeholder="例: game-1234" required>
        </div>
        <button type="submit">ゲーム記録画面へ</button>
      </form>
    </div>

    <div style="margin-top: 30px;">
      <a href="/ranking" class="btn btn-secondary">総合ランキングを見る</a>
      <a href="/logout" class="btn btn-danger" style="margin-top:10px;">ログアウト</a>
    </div>
  </div>
</body>
</html>