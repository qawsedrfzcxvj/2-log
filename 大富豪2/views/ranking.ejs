<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - 総合ランキング</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>総合点数ランキング</h1>
    <table>
      <tr>
        <th>順位</th>
        <th>ユーザー名</th>
        <th>所持ポイント</th>
      </tr>
      <% ranking.forEach((u, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= u.username %></td>
          <td><%= u.score %> pt</td>
        </tr>
      <% }); %>
    </table>

    <div style="margin-top:30px; border-top: 1px solid #ccc; padding-top: 15px;">
      <h3>週末リセット</h3>
      <p style="font-size:12px; color: #666;">全プレイヤーのポイントを100ptに戻します。</p>
      <form action="/ranking/reset" method="POST" onsubmit="return confirm('本当に全プレイヤーのポイントを100ptにリセットしますか？');">
        <button type="submit" class="btn btn-danger">点数を100ptにリセットする</button>
      </form>
    </div>

    <a href="/" class="btn btn-secondary" style="margin-top: 20px;">ダッシュボードに戻る</a>
  </div>
</body>
</html>