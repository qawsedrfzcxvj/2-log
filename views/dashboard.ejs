<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - ダッシュボード</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>ようこそ、<%= username %> さん</h1>
    <p style="text-align:center; font-size:18px;">現在の所持ポイント: <strong><%= score %> pt</strong></p>
    
    <div style="margin-top: 30px;">
      <h2>ゲームに参加する</h2>
      <form action="/game" method="GET">
        <div class="form-group">
          <label>ゲームIDを入力 (例: s5)</label>
          <input type="text" name="game_id" placeholder="例: s5" required>
        </div>
        <button type="submit">ゲーム画面へ</button>
      </form>
    </div>

    <div style="margin-top: 30px;">
      <a href="/ranking" class="btn btn-secondary">総合・グループ別ランキングを見る</a>
      <a href="/logout" class="btn btn-secondary" style="margin-top:10px; background: #7f8c8d;">ログアウト</a>
      
      <!-- アカウント削除機能 -->
      <form action="/account/delete" method="POST" onsubmit="return confirm('本当にアカウントを削除しますか？この操作は元に戻せません。');" style="margin-top: 15px;">
        <button type="submit" class="btn btn-danger">アカウントを削除する</button>
      </form>
    </div>
  </div>
</body>
</html>
