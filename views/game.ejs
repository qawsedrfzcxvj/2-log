<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - 自分の情報入力</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>ゲームルーム</h1>
    <p style="text-align:center;">ゲームID: <strong><%= gameId %></strong></p>

    <div class="form-group">
      <label>掛け金 (10pt以上、10pt刻み)</label>
      <input type="number" id="bet" value="10" min="10" step="10">
    </div>

    <div class="form-group">
      <label>サイコロ2個の合計目 (2〜12)</label>
      <input type="number" id="dice" value="7" min="2" max="12">
    </div>

    <div class="form-group">
      <label>あなたの残りカード枚数 (上がった人は0)</label>
      <input type="number" id="cards" min="0" value="0" required>
    </div>

    <button type="button" onclick="submitMyData()" class="btn">情報を送信して点数を計算する</button>

    <!-- 結果表示エリア -->
    <div id="resultArea" style="margin-top: 30px; display: none; background: #eef9f5; padding: 15px; border-radius: 6px;">
      <h2 style="margin-top:0; color:#27ae60;">計算完了</h2>
      <p style="font-size: 18px; margin: 5px 0;">今回の変動: <strong id="resChange"></strong></p>
      <p style="font-size: 18px; margin: 5px 0;">現在の順位: <strong id="resRank"></strong></p>
      <p style="font-size: 20px; margin: 10px 0 0 0; color:#2c3e50;">現在の所持ポイント: <strong id="resScore"></strong></p>
    </div>

    <a href="/" class="btn btn-secondary" style="margin-top: 20px;">ダッシュボードに戻る</a>
  </div>

  <script>
    const gameId = "<%= gameId %>";

    async function submitMyData() {
      const bet = document.getElementById('bet').value;
      const dice = document.getElementById('dice').value;
      const cards = document.getElementById('cards').value;

      if(cards === '') {
        alert('残りカード枚数を入力してください');
        return;
      }

      const res = await fetch('/game/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ game_id: gameId, bet, dice, cards })
      });

      const data = await res.json();
      if(data.error) {
        alert(data.error);
        return;
      }

      const sign = data.pointChange >= 0 ? '+' : '';
      document.getElementById('resChange').innerText = `${sign}${data.pointChange} pt`;
      document.getElementById('resRank').innerText = `${data.rank} 位 / ${data.totalPlayers} 人中`;
      document.getElementById('resScore').innerText = `${data.currentScore} pt`;
      
      document.getElementById('resultArea').style.display = 'block';
    }
  </script>
</body>
</html>
