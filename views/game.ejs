<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - 情報入力</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>ゲームルーム</h1>
    <p style="text-align:center;">ゲームID: <strong><%= gameId %></strong></p>

    <div class="form-group">
      <label>掛け金 (10pt以上、10pt刻み)</label>
      <input type="number" id="bet" value="10" min="10" step="10">
    </div>

    <div class="form-group">
      <label>サイコロ2個の合計目 (2〜12)</label>
      <input type="number" id="dice" value="7" min="2" max="12">
    </div>

    <div class="form-group">
      <label>残カード数 (他プレイヤーのカード数の総数 ※最下位は0)</label>
      <input type="number" id="other_cards_sum" min="0" value="0" required>
    </div>

    <button type="button" id="submitBtn" onclick="submitMyData()" class="btn">情報を送信する</button>

    <!-- 送信中の演出メッセージエリア -->
    <div id="msgArea" style="margin-top: 20px; text-align: center; font-weight: bold; color: #2980b9; font-size: 16px;"></div>

    <a href="/ranking" class="btn btn-secondary" style="margin-top: 20px;">ランキングで結果を確認する</a>
    <a href="/" class="btn btn-secondary" style="margin-top: 10px;">ダッシュボードに戻る</a>
  </div>

  <script>
    const gameId = "<%= gameId %>";

    async function submitMyData() {
      const bet = document.getElementById('bet').value;
      const dice = document.getElementById('dice').value;
      const other_cards_sum = document.getElementById('other_cards_sum').value;

      if(other_cards_sum === '') {
        alert('数値を入力してください');
        return;
      }

      const btn = document.getElementById('submitBtn');
      const msgArea = document.getElementById('msgArea');

      // 送信中の演出
      btn.disabled = true;
      btn.classList.add('pulsing');
      btn.innerText = '送信中...';
      msgArea.innerText = 'サーバーへデータを送信しています...';

      try {
        const res = await fetch('/game/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ game_id: gameId, bet, dice, other_cards_sum })
        });

        const data = await res.json();
        if(data.error) {
          alert(data.error);
          btn.disabled = false;
          btn.classList.remove('pulsing');
          btn.innerText = '情報を送信する';
          msgArea.innerText = '';
          return;
        }

        msgArea.innerText = data.message;
        
        // 成功時の演出（1.5秒後にメッセージ切り替えまたはリダイレクト）
        setTimeout(() => {
          if(data.status === 'completed') {
            window.location.href = '/ranking';
          } else {
            btn.disabled = false;
            btn.classList.remove('pulsing');
            btn.innerText = '情報を送信する（再送・更新）';
          }
        }, 1200);

      } catch (err) {
        alert('通信エラーが発生しました');
        btn.disabled = false;
        btn.classList.remove('pulsing');
        btn.innerText = '情報を送信する';
        msgArea.innerText = '';
      }
    }
  </script>
</body>
</html>
