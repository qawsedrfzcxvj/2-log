<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>大富豪2 - 点数計算</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>点数計算・記録</h1>
    <p>ゲームID: <strong><%= gameId %></strong></p>

    <div class="form-group">
      <label>掛け金 (10pt以上、10pt刻み)</label>
      <input type="number" id="bet" value="10" min="10" step="10">
    </div>

    <div class="form-group">
      <label>サイコロ2個の合計目 (2〜12)</label>
      <input type="number" id="dice" value="7" min="2" max="12">
    </div>

    <h2>参加プレイヤー情報</h2>
    <div id="playersContainer">
      <!-- プレイヤー追加エリア -->
    </div>
    <button type="button" onclick="addPlayerRow()" class="btn-secondary" style="margin-bottom: 15px;">＋ プレイヤーを追加</button>

    <button type="button" onclick="calculateAndSave()">点数を計算して記録する</button>

    <div id="resultArea" style="margin-top: 20px;"></div>

    <a href="/" class="btn btn-secondary" style="margin-top: 20px;">ダッシュボードに戻る</a>
  </div>

  <script>
    let playerCount = 0;

    function addPlayerRow() {
      playerCount++;
      const div = document.createElement('div');
      div.className = 'player-row';
      div.innerHTML = `
        <label>プレイヤー ${playerCount}</label>
        <input type="text" placeholder="ユーザー名" class="p-name" required style="margin-bottom:5px;">
        <input type="number" placeholder="上がり順位 (1〜)" class="p-rank" min="1" style="margin-bottom:5px;">
        <input type="number" placeholder="残りカード枚数 (上がった人は0)" class="p-cards" min="0" value="0">
      `;
      document.getElementById('playersContainer').appendChild(div);
    }

    // 最初は4人分デフォルト生成
    for(let i=0; i<4; i++) addPlayerRow();

    async function calculateAndSave() {
      const bet = document.getElementById('bet').value;
      const dice = document.getElementById('dice').value;
      const names = document.querySelectorAll('.p-name');
      const ranks = document.querySelectorAll('.p-rank');
      const cards = document.querySelectorAll('.p-cards');

      const players_data = [];
      for(let i=0; i<names.length; i++) {
        if(!names[i].value || !ranks[i].value) {
          alert('すべてのプレイヤー名と順位を入力してください');
          return;
        }
        players_data.push({
          username: names[i].value.trim(),
          rank: parseInt(ranks[i].value, 10),
          cards: parseInt(cards[i].value, 10) || 0
        });
      }

      const res = await fetch('/game/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          game_id: '<%= gameId %>',
          bet: bet,
          dice: dice,
          players_data: JSON.stringify(players_data)
        })
      });

      const data = await res.json();
      if(data.error) {
        alert(data.error);
        return;
      }

      let html = '<h2>計算結果（更新完了）</h2><table><tr><th>順位</th><th>ユーザー名</th><th>変動ポイント</th></tr>';
      data.results.sort((a,b) => a.rank - b.rank).forEach(r => {
        const sign = r.pointChange >= 0 ? '+' : '';
        html += `<tr><td>${r.rank}位</td><td>${r.username}</td><td>${sign}${r.pointChange} pt</td></tr>`;
      });
      html += '</table>';
      document.getElementById('resultArea').innerHTML = html;
    }
  </script>
</body>
</html>